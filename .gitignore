.venv/
__pycache__/
*.pyc
.pytest_cache/
data/basket.db
data/cache/
.streamlit/secrets.toml
# макеты канваса — рабочие файлы дизайна, живут в опубликованном артефакте.
# Косая черта СПЕРЕДИ обязательна: без неё правило совпадает с папкой на любой
# глубине и прячет docs/design/ — замыслы каталога и расширения оказывались вне git.
/design/
data/users/
# Ключи языковых моделей для запасного разбора вёрстки. На сервере такой файл живёт
# в /opt/korzina/llm.env; если понадобится локальный — он не должен уехать в git.
llm.env
*.env
data/session.key
# Общий каталог и очередь адресов — рабочая база, живёт в томе на сервере (DEPLOY.md).
# В очереди лежат настоящие адреса доставки, а репозиторий публичный.
data/catalog.db
data/*.db-shm
data/*.db-wal
# Собранный APK проверки кук и следы его перегонки с сервера; исходники — в android/probe.
android/*.apk
android/apk.b64
android/apk.err
# Следы сборки Gradle: кеш и собранный APK, в который вшит адрес сервера (BuildConfig).
# Собирают в Docker (android/app/Dockerfile.build), в git живут только исходники.
android/*/.gradle/
android/*/app/build/
# Раздаваемый сайтом APK кладут в том данных (app/web/apk.py), а не в репозиторий.
data/apk/
# Общий темп запросов к сетям между процессами (app/connectors/cache.reserve).
data/pace/
