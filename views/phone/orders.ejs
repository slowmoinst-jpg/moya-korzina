<%- include('_head', { title: 'История заказов — Моя корзина', phClass: 'grey' }) %>
  <a class="back" href="/phone/basket"><%- icon('back') %>Корзина</a>
  <h1 class="title">История заказов</h1>

  <% if (!orders || !orders.length) { %>
    <div class="empty">
      Заказов пока нет — они берутся из чеков. Подключите «Мои чеки» в Настройках, и покупки
      появятся здесь. Корзину можно собрать и без них: найдите товар поиском на экране «Корзина».
    </div>
    <a class="bt ghost" href="/phone/settings" style="align-self: center">Настройки</a>
  <% } %>

  <% months.forEach(([title, group]) => { %>
    <h2 class="month"><%= title %></h2>
    <% group.forEach((o) => { %>
      <section class="ord" aria-label="Заказ <%= o.day %>, <%= o.store_name %>">
        <div class="oh">
          <%- mark(o.store_code, o.store_name) %>
          <span class="sn"><span class="store-name"><%= o.store_name %></span> <span class="mut small">· <%= o.day %></span></span>
          <span class="tot num"><%= whole(o.total) %></span>
        </div>
        <details class="comp">
          <summary class="th" aria-label="Состав заказа: <%= goods(o.count) %>">
            <% o.thumbs.forEach((t) => { %><span class="t"><%- pic(t) %></span><% }) %>
            <% if (o.thumbs_more > 0) { %><span class="more num">+<%= o.thumbs_more %></span><% } %>
          </summary>
          <div class="lines">
            <% o.head.forEach((ln) => { %>
              <div class="ln">
                <span class="t"><%- pic(ln) %></span>
                <span class="nm"><%= ln.name %></span>
                <span class="q num"><%= ln.qty %></span>
                <span class="p num"><%= rub(ln.total) %></span>
              </div>
            <% }) %>
            <% if (o.rest && o.rest.length) { %>
              <details class="rest-det">
                <summary class="rest">Ещё <%= goods(o.rest.length) %><%- icon('down', 'i s') %></summary>
                <% o.rest.forEach((ln) => { %>
                  <div class="ln">
                    <span class="t"><%- pic(ln) %></span>
                    <span class="nm"><%= ln.name %></span>
                    <span class="q num"><%= ln.qty %></span>
                    <span class="p num"><%= rub(ln.total) %></span>
                  </div>
                <% }) %>
              </details>
            <% } %>
          </div>
        </details>
        <div class="of">
          <span class="mut small"><%= goods(o.count) %></span>
          <% if (o.in_basket) { %>
            <span class="badge inb"><%- icon('check', 'i s') %>В корзине</span>
          <% } else { %>
            <form method="post" action="/phone/orders">
              <input type="hidden" name="key" value="<%= o.key %>">
              <button class="bt big" type="submit">Повторить</button>
            </form>
          <% } %>
        </div>
      </section>
    <% }) %>
  <% }) %>

  <% if (more > 0) { %>
    <a class="bt ghost" href="/phone/orders?n=<%= next_n %>" style="align-self: center">Показать ещё заказы</a>
  <% } %>
<%- include('_foot', { tab }) %>
