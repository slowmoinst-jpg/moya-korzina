<%- include('_head', { title: 'Корзины — Моя корзина' }) %>
  <a class="back" href="/phone/basket"><%- icon('back') %>Корзина</a>
  <h1 class="title">Корзины</h1>

  <% if (!baskets || !baskets.length) { %>
    <div class="empty">Корзин пока нет. Найдите товар поиском на экране «Корзина» — корзина заведётся сама.</div>
    <a class="bt ghost" href="/phone/basket" style="align-self: center">К поиску товара</a>
  <% } else { %>
    <section>
      <div class="grp">Все корзины<span class="right num"><%= baskets.length %></span></div>
      <div class="card">
        <% baskets.forEach((b) => { %>
          <div class="row">
            <span class="grow">
              <span style="display: block"><%= b.name %></span>
              <span class="mut small">создана <%= b.day %> · <%= goods(b.count) %></span>
            </span>
            <% if (b.open) { %>
              <span class="gd small" style="display: inline-flex; align-items: center; gap: 4px; font-weight: 500"><%- icon('check', 'i s') %>открыта</span>
            <% } else { %>
              <form method="post" action="/phone/baskets/<%= b.id %>">
                <button class="bt" type="submit">Открыть</button>
              </form>
            <% } %>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>
<%- include('_foot', { tab }) %>
