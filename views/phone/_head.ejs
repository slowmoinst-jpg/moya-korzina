<!doctype html>
<html lang="ru" data-device="<%= device_phone ? 'phone' : 'web' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#F3F4F6">
  <title><%= typeof title !== 'undefined' ? title : 'Моя корзина' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Unbounded:wght@600;700&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Unbounded:wght@600;700&display=swap"></noscript>
  <link rel="stylesheet" href="<%= staticV('phone.css') %>">
  <script src="<%= staticV('korzina-device.js') %>" defer></script>
  <%- typeof headExtra !== 'undefined' ? headExtra : '' %>
</head>
<body>
<div class="ph <%= typeof phClass !== 'undefined' ? phClass : '' %>">
  <main class="ph-body">
    <% if (is_demo) { %>
      <div class="note act <%= typeof reqDemo !== 'undefined' && reqDemo ? 'bad hot' : 'warn' %>" role="status">
        <span>Это демо — смотреть можно, менять нельзя.</span>
        <form method="post" action="/logout">
          <button class="bt" type="submit">Войти по своему номеру</button>
        </form>
      </div>
    <% } %>
