<%- include('_head', {
  title: 'Настройки — Моя корзина',
  headExtra: '<link rel="stylesheet" href="/static/leaflet/leaflet.css">'
}) %>
  <h1 class="title">Настройки</h1>

  <% if (saved === 'address') { %>
    <div class="note ok">Адрес сохранён. Цены по нему обновятся сами.</div>
  <% } %>
  <% if (connect) { %>
    <div class="note warn">Чтобы заказать <%= where(connect) %>, подключите магазин — войдите в него своим номером.</div>
  <% } %>
  <% if (saved === 'disconnected') { %>
    <div class="note ok"><% if (disconnected_name) { %>Вход в «<%= disconnected_name %>» отключён.<% } else { %>Вход отключён.<% } %> На этом телефоне сеть может помнить вход, пока не выйдете в её окне.</div>
  <% } %>
  <% if (connected_name) { %>
    <div class="note ok">Подключено: <%= connected_name %></div>
  <% } %>
  <% if (no_stores) { %>
    <div class="note">Магазины не настроены — в приложении пока нет ни одной сети.</div>
  <% } else if (first_run) { %>
    <div class="note warn">Пока не подключён ни один магазин. Подключите хотя бы один — и приложение соберёт корзину в его кабинете само.</div>
  <% } %>

  <% if (stores && stores.length) { %>
  <section class="card sum" aria-label="Магазины">
    <div class="sr">
      <span class="lb">Магазины</span>
      <span class="big num"><%= connected.length %> из <%= stores.length %></span>
    </div>
    <div class="bar" aria-hidden="true"><span style="width: <%= stores.length ? Math.round((connected.length * 100) / stores.length) : 0 %>%"></span></div>
    <% if (waiting && waiting.length) { %>
      <div class="lt num">Осталось подключить · <%= waiting.length %></div>
      <div class="wg">
        <% waiting.forEach((s) => { %>
          <a class="wt" href="/phone/connect/<%= s.code %>" data-open-store="<%= s.code %>" data-login
             <% if (!s.again) { %>aria-label="Подключить: <%= s.name %>"<% } %>>
            <%- mark(s.code, s.name) %>
            <span class="wt-name"><%= s.name %></span>
            <% if (s.again) { %>
              <span class="vh"> · вход истёк — войти снова</span>
              <%- icon('alert', 'i s add wr') %>
            <% } else { %>
              <%- icon('plus', 'i s add') %>
            <% } %>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>
  <% } %>

  <% if (connected && connected.length) { %>
    <section>
      <div class="grp">Подключено</div>
      <div class="card conn-card" aria-label="Подключённые магазины">
        <% connected.forEach((s) => {
          const b = board_by ? board_by[s.code] : null;
        %>
          <div class="row">
            <%- mark(s.code, s.name) %>
            <span class="g">
              <span class="nm"><%= s.name %></span>
              <% if (b) { %>
                <% if (b.ready) { %>
                  <span class="st ok"><%- icon('check', 'i s') %>собрано<% if (b.sum) { %> · <span class="num"><%= whole(b.sum) %></span><% } %></span>
                <% } else if (b.next) { %>
                  <span class="st wr"><%- icon('alert', 'i s') %><span class="st-text"><%= b.next %></span></span>
                <% } %>
              <% } %>
            </span>
            <details class="menu">
              <summary class="ib" aria-label="Ещё: <%= s.name %>"><%- icon('more') %></summary>
              <div class="menu-pop">
                <form method="post" action="/phone/settings/disconnect">
                  <input type="hidden" name="store" value="<%= s.code %>">
                  <button class="bt ghost" type="submit">Отключить вход</button>
                </form>
                <div class="mut small">«Отключить вход» стирает сохранённые куки на сервере.</div>
                <a class="mut small" href="/accounts">Изменить</a>
              </div>
            </details>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section>
    <div class="grp">Чеки</div>
    <div class="card">
      <a class="row" href="/phone/receipts">
        <%- icon('receipt') %>
        <span class="grow">Мои чеки (ФНС)</span>
        <% if (fns.connected) { %>
          <span class="gd num small"><%= fns.label %></span><%- icon('check', 'i s gd') %>
        <% } else { %>
          <span class="bt">Подключить</span>
        <% } %>
      </a>
    </div>
  </section>

  <section>
    <div class="grp">Телефон и адрес</div>
    <div class="card addr-card">
      <div class="row">
        <%- icon('phone') %>
        <span class="grow num"><%= is_demo ? 'Демо' : (phone_label || phone) %></span>
        <form method="post" action="/logout">
          <button class="bt ghost" type="submit">Выйти</button>
        </form>
      </div>
      <details id="address" <%= (edit === 'address' || !address || map_open) ? 'open' : '' %>>
        <summary class="row" style="list-style: none; cursor: pointer">
          <%- icon('pin') %>
          <span class="grow"><%= address || 'Укажите адрес доставки' %></span>
          <%- icon('next', 'i s mut') %>
        </summary>
        <form method="post" action="/phone/settings" class="field addr" id="addr-form">
          <div class="addr-box">
            <div class="addr-row">
              <input id="addr-input" name="address" value="<%= address || '' %>"
                     placeholder="Город, улица, дом" aria-label="Адрес доставки"
                     autocomplete="off" autocapitalize="off" autocorrect="off"
                     spellcheck="false" aria-autocomplete="list" aria-controls="addr-list">
              <button class="bt ghost" type="button" id="addr-find">Найти</button>
            </div>
            <div class="sugg" id="addr-list" role="listbox" aria-label="Подсказки адреса" hidden></div>
          </div>
          <input type="hidden" name="point" id="addr-point" value="<%= point_text %>">
          <div class="addr-row">
            <a class="bt ghost" id="addr-map-show" href="/phone/settings?map=1#address">Показать на карте</a>
            <button class="bt" type="submit">Сохранить</button>
          </div>
        </form>
        <div class="map" id="addr-map"
             data-suggest-url="/phone/address/suggest"
             data-reverse-url="/phone/address/reverse"
             data-tile-base="<%= tile_base %>"
             data-lat="<%= center ? center[0].toFixed(6) : '' %>"
             data-lon="<%= center ? center[1].toFixed(6) : '' %>"
             aria-label="Карта адреса"<% if (!map_open) { %> hidden<% } %>></div>
        <div class="map-hint" id="addr-map-hint"<% if (!map_open) { %> hidden<% } %>>
          Поставьте пин касанием или перетащите его — адрес подставится сам.
        </div>
      </details>
    </div>
  </section>

  <a class="mut small" href="/?web=1" style="text-align: center; padding: 6px 0">Полная версия приложения</a>

<%- include('_foot', {
  tab,
  actionsExtra: `<script>
    document.addEventListener('click', function (e) {
      var link = e.target.closest('[data-open-store]');
      if (link && window.KorzinaDevice) {
        var code = link.getAttribute('data-open-store');
        var ok = link.hasAttribute('data-login') ? KorzinaDevice.login(code) : KorzinaDevice.openStore(code);
        if (ok) e.preventDefault();
      }
    });
  </script>`,
  scriptsExtra: `<script src="/static/leaflet/leaflet.js" defer></script><script src="${staticV('phone-map.js')}" defer></script>`
}) %>
