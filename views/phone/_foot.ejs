  </main>
  <div class="ph-foot">
    <%- typeof actionsExtra !== 'undefined' ? actionsExtra : '' %>
    <% if (typeof tab !== 'undefined' && tab) { %>
      <nav class="tabs" aria-label="Разделы">
        <a class="tab <%= tab === 'basket' ? 'on' : '' %>" href="/phone/basket"
           <% if (tab === 'basket') { %>aria-current="page"<% } %>><span class="ico"><%- icon('cart') %></span><span>Корзина</span></a>
        <a class="tab <%= tab === 'settings' ? 'on' : '' %>" href="/phone/settings"
           <% if (tab === 'settings') { %>aria-current="page"<% } %>><span class="ico"><%- icon('gear') %></span><span>Настройки</span></a>
      </nav>
    <% } %>
  </div>
</div>
<% if (!is_demo) { %>
<script data-kz-collect-all>
  function kzCollectAll() {
    if (document.getElementById('kz-runs')) { return; }
    if (!window.KorzinaDevice || !KorzinaDevice.collect) { return; }
    fetch('/phone/basket/runs', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (j) {
        if (j && j.collect && window.KorzinaDevice && KorzinaDevice.collect) {
          KorzinaDevice.collect(j.collect);
        }
      })
      .catch(function () {});
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', kzCollectAll); }
  else { kzCollectAll(); }
</script>
<% } %>
<%- typeof scriptsExtra !== 'undefined' ? scriptsExtra : '' %>
</body>
</html>
