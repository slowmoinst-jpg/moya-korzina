<% if (runs && ((runs.rows && runs.rows.length) || (runs.idle && runs.idle.length))) { %>
  <div class="grp">Корзина в магазинах</div>
  <div class="card">
    <% runs.rows.forEach((r) => { %>
      <a class="row run <%= r.state %>" href="/cabinet?store=<%= r.code %>" data-open-store="<%= r.code %>" data-run="<%= r.code %>">
        <%- mark(r.code, r.name) %>
        <span class="grow">
          <span class="rn"><%= r.name %></span>
          <span class="mut small sub" data-run-words><%= r.words %></span>
          <% if (r.state === 'going' && (r.now || r.left)) { %><span class="mut small sub" data-run-now><%= r.now %><% if (r.left) { %> · <%= r.left %><% } %></span><% } %>
          <% if (['failed', 'empty', 'interrupted'].includes(r.state) && r.note) { %><span class="mut small sub"><%= r.note %></span><% } %>
          <% if (r.state === 'done' && r.gone) { %><span class="mut small sub">нет в наличии: <%= r.gone %></span><% } %>
          <% if (r.state === 'done' && r.extra_note) { %><span class="mut small sub"><%= r.extra_note %></span><% } %>
        </span>
        <% if (r.state === 'login') { %>
          <span class="bt small" style="white-space: nowrap"><%= r.login === 'store' ? 'Выбрать магазин' : 'Войти' %></span>
        <% } else if (r.total) { %>
          <span class="num <%= r.state === 'old' ? 'mut' : '' %>" style="font-weight: 800"><%= rub(r.total.sum) %></span>
          <% if (r.total.network) { %><span class="badge white" title="Итог посчитала сама сеть: с её скидками и акциями">сеть</span><% } %>
        <% } else if (r.state === 'going') { %>
          <span class="spin" aria-hidden="true"></span>
        <% } %>
      </a>
    <% }) %>
    <% if (runs.idle && runs.idle.length) { %>
      <a class="row small" href="/phone/settings">
        <span class="grow mut">Без входа: <%= runs.idle.join(', ') %></span>
        <span style="font-weight: 600">Подключить</span><%- icon('next', 'i s') %>
      </a>
    <% } %>
  </div>
<% } %>
