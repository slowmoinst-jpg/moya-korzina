<%- include('_head', { title: 'Где дешевле — Моя корзина' }) %>
  <a class="back" href="/phone/basket"><%- icon('back') %>Корзина</a>
  <h1 class="title">Где дешевле</h1>

  <% if (no_address) { %>
    <div class="note warn act">
      <span>Укажите адрес доставки — от него зависят цены и наличие</span>
      <a class="bt" href="/phone/settings#address">Указать адрес</a>
    </div>
  <% } %>

  <% if (!basket) { %>
    <div class="empty">Корзина пуста — повторите заказ из истории, и здесь появится, где он дешевле.</div>
  <% } else if (!variants || !variants.length) { %>
    <% if (unpriced && unpriced.length) { %>
      <div class="empty">
        Пока нет цен ни в одной сети на:
        <% unpriced.slice(0, 5).forEach((name) => { %><br>· <%= name %><% }) %>
        <% if (unpriced.length > 5) { %><br>и ещё <%= unpriced.length - 5 %><% } %>
        <br>Добавьте товар поиском на экране «Корзина».
      </div>
    <% } else { %>
      <div class="empty">Пока не хватает цен, чтобы посчитать.</div>
    <% } %>
  <% } else { %>
    <% if (sent) { %>
      <div class="note ok">Корзина собирается <%= where(sent) %> — это пара минут. Потом откройте её в приложении магазина и оплатите.<% if (left) { %> Часть товаров не уехала: <%= left %>.<% } %></div>
    <% } else if (why === 'gone') { %>
      <div class="note warn">Положить нечего: ни одного товара <%= where(why_store) %> сейчас нет в наличии.</div>
    <% } %>

    <ol class="board" aria-label="Лучшие места">
      <% places.forEach((p) => { %>
        <li>
          <a class="pl <%= p.best ? 'win' : '' %> <%= p.on ? 'on' : '' %>" href="/phone/cheaper?pick=<%= p.n %>"
             data-place="<%= p.codes.join('+') %>"
             <% if (p.on) { %>aria-current="true"<% } %>>
            <span class="rk num" aria-hidden="true"><%= p.rank %></span>
            <span class="mid">
              <span class="nm"><%= p.title %></span>
              <span class="sig">
                <% if (p.counts.length > 1) { %>
                  <span class="mcs">
                    <% p.counts.forEach(([code, n], idx) => { %><% if (idx > 0) { %><span class="dot" aria-hidden="true">·</span><% } %><span class="mc"><%- mark(code) %><%= n %><span class="vh"><%= goods(n) %> <%= where(code) %></span></span><% }) %>
                  </span>
                <% } else { %>
                  <%- mark(p.codes[0]) %>
                <% } %>
                <% if (p.full) { %>
                  <span class="sig ok"><span class="sig-ico"><%- icon('check', 'i s') %></span><%= p.of %>/<%= p.of %><span class="vh">все товары есть</span></span>
                <% } else { %>
                  <span class="sig wr"><%- icon('alert', 'i s') %><%= p.of - p.lack %>/<%= p.of %><span class="vh">нашлось <%= p.of - p.lack %> из <%= p.of %></span></span>
                <% } %>
                <% if (p.best) { %><span class="vh">Рекомендуем</span><% } %>
              </span>
            </span>
            <span class="pr">
              <span class="p num"><%- whole(p.total, true) %></span>
              <% if (!p.best && p.diff) { %>
                <span class="d num"><%= p.diff > 0 ? '+' : '−' %><%= whole(Math.abs(p.diff)) %></span>
              <% } %>
            </span>
          </a>
        </li>
      <% }) %>
    </ol>

    <% if (more_places && more_places.length) { %>
      <details class="det more">
        <summary>Ещё варианты — <%= more_places.length %></summary>
        <ol class="board board-more">
          <% more_places.forEach((p) => { %>
            <li>
              <a class="pl <%= p.on ? 'on' : '' %>" href="/phone/cheaper?pick=<%= p.n %>" data-place="<%= p.codes.join('+') %>">
                <span class="rk num" aria-hidden="true"><%= p.rank %></span>
                <span class="mid">
                  <span class="nm"><%= p.title %></span>
                  <span class="sig">
                    <%- mark(p.codes[0]) %>
                    <% if (p.full) { %>
                      <span class="sig ok"><span class="sig-ico"><%- icon('check', 'i s') %></span><%= p.of %>/<%= p.of %></span>
                    <% } else { %>
                      <span class="sig wr"><%- icon('alert', 'i s') %><%= p.of - p.lack %>/<%= p.of %></span>
                    <% } %>
                  </span>
                </span>
                <span class="pr">
                  <span class="p num"><%- whole(p.total, true) %></span>
                  <% if (p.diff) { %><span class="d num">+<%= whole(Math.abs(p.diff)) %></span><% } %>
                </span>
              </a>
            </li>
          <% }) %>
        </ol>
      </details>
    <% } %>

    <% if (chosen) { %>
      <section class="split" aria-label="Из чего сложено: <%= chosen.title %>">
        <% chosen.parts.forEach((part) => { %>
          <div class="sp">
            <div class="sh">
              <%- mark(part.code) %>
              <span class="g"><%= part.name %></span>
              <span class="mut num"><%= goods(part.count) %></span>
              <span class="p-sum num"><%= whole(part.total) %></span>
            </div>
            <% if (part.thumbs && part.thumbs.length) { %>
              <div class="th" aria-hidden="true">
                <% part.thumbs.forEach((t) => { %><span class="t"><%- pic(t) %></span><% }) %>
                <% if (part.more > 0) { %><span class="more num">+<%= part.more %></span><% } %>
              </div>
            <% } %>
          </div>
        <% }) %>
        <details class="det">
          <summary class="sigs">
            <span class="sig <%= chosen.delivery > 0 ? 'warn' : '' %>">
              <%- icon('truck') %><span class="vh">доставка</span><%= chosen.delivery > 0 ? '+' : '' %><%= whole(chosen.delivery) %>
            </span>
            <% if (chosen.live_at) { %>
              <span class="sig mut"><%- icon('clock') %><span class="vh">цены на</span><%= chosen.live_at %></span>
            <% } %>
            <span class="sig" style="margin-left: auto"><%- icon('receipt') %><span class="vh">Из чего сумма</span></span>
          </summary>
          <div class="rc">
            <div><span>Товары</span><span class="num"><%= rub(chosen.subtotal) %></span></div>
            <% if (chosen.discount) { %>
              <div style="color: var(--green)"><span>Скидки и кэшбэк</span><span class="num">−<%= rub(chosen.discount) %></span></div>
            <% } %>
            <div><span>Доставка<% if (chosen.stores > 1) { %> ×<%= chosen.stores %><% } %></span><span class="num"><%= rub(chosen.delivery) %></span></div>
            <div class="tot"><span>Итого</span><span class="num"><%= rub(chosen.total) %></span></div>
          </div>
        </details>
      </section>
      <% if (chosen.missing && chosen.missing.length) { %>
        <div class="note warn">Не нашли цену для: <%= chosen.missing.join(', ') %>.</div>
      <% } %>
    <% } %>
  <% } %>

<%
let actionsHtml = '';
if (chosen) {
  actionsHtml = '<div class="actions" style="flex-direction: column">';
  chosen.parts.forEach((part, idx) => {
    const altCls = idx === 0 ? '' : 'alt';
    if (part.needs_login) {
      actionsHtml += `<a class="cta ${altCls}" href="/phone/connect/${escapeHtml(part.code)}" data-open-store="${escapeHtml(part.code)}">Подключить ${escapeHtml(part.whom)}${part.again ? ' заново' : ''}</a>`;
    } else {
      actionsHtml += `<form method="post" action="/phone/cheaper" style="width: 100%" data-store="${escapeHtml(part.code)}" data-phone-fills="${part.by_link ? 0 : 1}" data-lines="${escapeHtml(part.lines_json)}" data-order="${escapeHtml(chosen.order_json)}">`;
      actionsHtml += `<input type="hidden" name="store" value="${escapeHtml(part.code)}">`;
      if (pick !== null && pick !== undefined) actionsHtml += `<input type="hidden" name="pick" value="${escapeHtml(pick)}">`;
      actionsHtml += `<button class="cta ${altCls}" type="submit"><span>Заказать ${escapeHtml(part.where)}</span><span class="num">${escapeHtml(whole(part.total))}</span></button></form>`;
    }
  });
  actionsHtml += '</div>';
}
actionsHtml += `<script>
  document.addEventListener('click', function (e) {
    var link = e.target.closest('[data-open-store]');
    if (link && window.KorzinaDevice && KorzinaDevice.openStore(link.getAttribute('data-open-store'))) { e.preventDefault(); }
  });
  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (form.getAttribute('data-phone-fills') === '1' && window.KorzinaDevice && KorzinaDevice.available()) {
      var store = form.getAttribute('data-store');
      var lines = form.getAttribute('data-lines');
      var order = form.getAttribute('data-order');
      if (order && typeof KorzinaDevice.ordered === 'function') KorzinaDevice.ordered(order);
      if (lines && KorzinaDevice.openStore(store, lines)) e.preventDefault();
      else if (KorzinaDevice.openStore(store)) e.preventDefault();
    }
  });
</script>`;
%>
<%- include('_foot', { tab, actionsExtra: actionsHtml }) %>
