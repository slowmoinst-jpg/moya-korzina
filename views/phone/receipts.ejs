<%- include('_head', { title: 'Мои чеки — Моя корзина' }) %>
  <a class="back" href="/phone/settings"><%- icon('back') %>Настройки</a>
  <h1 class="title">Мои чеки</h1>

  <% flashes.forEach(([kind, message]) => { %>
    <div class="note <%= ['ok', 'warn', 'bad'].includes(kind) ? kind : '' %>"><%= message %></div>
  <% }) %>

  <section>
    <div class="grp">Ваша история</div>
    <% if (headline) { %><div class="mut small" style="padding: 0 2px"><%= headline %></div><% } %>
    <div class="card">
      <div class="row" style="flex-wrap: wrap; gap: 6px; padding-top: 8px; padding-bottom: 8px">
        <% if (have.receipts) { %><span class="chip"><span class="mut">Чеков</span> <b class="num"><%= have.receipts %></b></span><% } %>
        <span class="chip"><span class="mut">Позиций</span> <b class="num"><%= have.rows %></b></span>
        <% if (have.total) { %><span class="chip"><span class="mut">На сумму</span> <b class="num"><%= rub(have.total) %></b></span><% } %>
      </div>
      <% if (have.months) { %>
        <div class="row">
          <span class="grow small mut">Срок истории</span>
          <span class="small num"><%= have.months %> мес.</span>
        </div>
      <% } %>
    </div>
  </section>

  <section>
    <div class="grp">Кабинет ФНС</div>
    <div class="card">
      <div class="row">
        <%- icon('receipt') %>
        <span class="grow">
          <% if (demo) { %>Демо — общая витрина
          <% } else if (connected) { %>Подключён<% if (connected_phone) { %> · <span class="num"><%= connected_phone %></span><% } %>
          <% } else { %>Не подключён<% } %>
        </span>
        <% if (connected) { %><span class="gd small">подключён</span>
        <% } else if (!demo) { %><span class="mut small">не подключён</span><% } %>
      </div>

      <% if (demo) { %>
        <div class="row" style="padding-top: 8px; padding-bottom: 8px">
          <span class="grow small mut">Демо открывает любой, кто нажал «Посмотреть демо». Ключ от настоящего кабинета ФНС сюда класть нельзя.</span>
        </div>
      <% } else if (connected) { %>
        <div class="row">
          <span class="grow small mut">Последняя проверка</span>
          <span class="small num"><%= synced || 'ещё не было' %></span>
        </div>
        <div class="row">
          <span class="grow small mut">Загруженные чеки останутся в истории, даже если отключить кабинет.</span>
          <form method="post" action="/phone/receipts">
            <input type="hidden" name="do" value="disconnect">
            <button class="bt ghost" type="submit">Отключить</button>
          </form>
        </div>
      <% } else { %>
        <div class="row" style="padding-top: 8px; padding-bottom: 8px">
          <span class="grow small mut">В приложении есть окно кабинета ФНС, а на компьютере можно вставить ключ или загрузить чеки на полной версии.</span>
        </div>
      <% } %>

      <% if (!demo) { %>
        <details id="keys" <%= !connected ? 'open' : '' %>>
          <summary class="row" style="list-style: none; cursor: pointer">
            <%- icon('receipt') %>
            <span class="grow"><%= connected ? 'Вставить новый ключ' : 'Подключить ключом' %></span>
            <%- icon('next', 'i s mut') %>
          </summary>
          <form method="post" action="/phone/receipts" style="padding: 8px 12px 12px; display: flex; flex-direction: column; gap: 8px">
            <input type="hidden" name="do" value="keys">
            <textarea name="keys" rows="3" placeholder='{"source": "lkdr-keys", "token": "…"}' style="width:100%;border:1px solid var(--line2);border-radius:8px;padding:8px 12px;"></textarea>
            <button class="bt" type="submit" style="align-self: flex-start">Подключить</button>
          </form>
        </details>
      <% } %>
    </div>
  </section>

<%
let actionsHtml = '<div class="actions">';
if (connected) {
  actionsHtml += '<form method="post" action="/phone/receipts" style="flex:1;display:flex"><input type="hidden" name="do" value="sync"><button class="cta" type="submit">Загрузить сейчас</button></form>';
} else if (demo) {
  actionsHtml += '<a class="cta ghost" style="flex:1;width:auto" href="/phone/settings">Войти по номеру</a>';
} else {
  actionsHtml += '<a class="cta" style="flex:1;width:auto" href="#keys">Вставить ключ</a>';
}
actionsHtml += `<a class="cta ghost" href="${full_url}">Полная версия</a></div>`;
%>
<%- include('_foot', { tab, actionsExtra: actionsHtml }) %>
