<%- include('_head', { title: 'Товары — Моя корзина' }) %>
<div class="card">
  <form method="get" action="/products" class="cart-find">
    <input name="q" value="<%= q %>" placeholder="Фильтр по названию или категории">
    <button class="btn" type="submit">Найти</button>
  </form>
</div>
<div class="card">
  <% products.forEach((p) => { %>
    <div class="row" style="justify-content:space-between;padding:7px 0;border-top:1px solid var(--line)">
      <div>
        <strong><%= p.name %></strong>
        <div class="dim" style="font-size:0.85rem"><%= p.category || 'Прочее' %> · <%= unitLabel(p.unit) %> · в <%= p.storesCount %> сетях</div>
      </div>
      <span class="sum">
        <% if (p.minPrice !== null) { %>
          <%= rub(p.minPrice) %><% if (p.maxPrice && p.maxPrice > p.minPrice) { %> — <%= rub(p.maxPrice) %><% } %>
        <% } else { %>—<% } %>
      </span>
    </div>
  <% }) %>
</div>
<%- include('_foot') %>
