<%- include('_head', { title: 'Карты и акции — Моя корзина' }) %>
<div class="card">
  <h3>Активные предложения по картам (<%= offers.length %>)</h3>
  <% if (!offers.length) { %>
    <p class="dim">Предложений по кэшбэку пока нет.</p>
  <% } else { %>
    <% offers.forEach((o) => { %>
      <div class="row" style="justify-content:space-between;padding:8px 0;border-top:1px solid var(--line)">
        <div>
          <span class="dot s-<%= o.store_code %>"></span>
          <strong><%= o.store_name %></strong>
          <span class="dim">· <%= o.bank %> «<%= o.card_name %>»</span>
          <div class="dim" style="font-size:0.85rem">лимит <%= rub(o.cap_rub) %> (использовано <%= rub(o.cap_used) %>)<% if (o.min_check_rub) { %> · от <%= rub(o.min_check_rub) %><% } %></div>
        </div>
        <span class="pill" style="border-color:var(--green);color:var(--green);font-weight:700"><%= o.percent %>%</span>
      </div>
    <% }) %>
  <% } %>
</div>

<div class="card">
  <h3>Добавить кэшбэк по карте</h3>
  <form method="post" action="/cards">
    <div class="grid two">
      <div><label class="dim">Банк</label><input name="bank" placeholder="Т-Банк" required></div>
      <div><label class="dim">Карта</label><input name="name" placeholder="Black" required></div>
      <div>
        <label class="dim">Магазин</label>
        <select name="store_id">
          <% stores.forEach((s) => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
        </select>
      </div>
      <div><label class="dim">Процент %</label><input name="percent" type="number" step="0.5" value="5" required></div>
      <div><label class="dim">Лимит (₽)</label><input name="cap_rub" type="number" value="500"></div>
      <div><label class="dim">Мин. чек (₽)</label><input name="min_check_rub" type="number" value="0"></div>
    </div>
    <button class="btn main" type="submit" style="margin-top:12px">Добавить акцию</button>
  </form>
</div>
<%- include('_foot') %>
