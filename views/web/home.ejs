<%- include('_head', { title: 'Моя корзина' }) %>

<% if (saved) { %>
  <div class="note ok">Адрес сохранён. Цены по нему обновляются.
    <% if (fresh) { %>Корзина «<%= fresh.name %>» пересчитана — <a href="/basket?id=<%= fresh.id %>">открыть корзину</a>.<% } %>
  </div>
<% } %>
<% if (note) { %><div class="note <%= note.kind %>"><%= note.text %></div><% } %>

<div class="card">
  <h2>Те же продукты, меньше денег</h2>
  <p class="muted">Читаем ваши чеки, находим эти же товары в сетях с доставкой и собираем
    корзину там, где дешевле. В расчёт идут платная доставка и скидки ваших карт.</p>
</div>

<div class="card" id="address">
  <div class="row">
    <span class="pill" style="border-color:var(--line2);color:var(--ink3)">Шаг 1</span>
    <h3 style="margin:0">Куда везём</h3>
  </div>
  <p class="dim">Адрес задаёт цены и наличие во всех сетях. Сменили адрес — цифры пересчитаются по нему.</p>
  <form method="post" action="/address" autocomplete="off">
    <div class="sugg-wrap">
      <input id="addr-input" name="address" type="text" value="<%= address || '' %>"
             placeholder="Москва, Ходынский бульвар 4" autocomplete="off"
             autocapitalize="off" spellcheck="false"
             role="combobox" aria-autocomplete="list" aria-expanded="false"
             aria-controls="addr-list">
      <ul id="addr-list" class="sugg" role="listbox" hidden></ul>
    </div>
    <div class="row" style="margin-top:10px">
      <button class="btn main" type="submit">Сохранить адрес</button>
      <% if (address) { %><a class="btn" href="/?check=1#address">Проверить адрес</a><% } %>
    </div>
  </form>

  <% if (checked) { %>
    <div class="note ok" style="margin-top:12px">Адрес понят.
      <% checked.forEach((c, idx) => { %>
        <%= c.chain %> — <%= c.shop %><% if (c.far) { %> · <%= c.far %><% } %><%= idx < checked.length - 1 ? '; ' : '.' %>
      <% }) %>
    </div>
  <% } %>
</div>

<div class="grid two">
  <% steps.forEach((s) => { %>
    <div class="card">
      <div class="row">
        <span class="pill" style="border-color:<%= s.done ? 'var(--green)' : 'var(--line2)' %>;color:<%= s.done ? 'var(--green)' : 'var(--ink3)' %>">Шаг <%= s.n %></span>
        <h3 style="margin:0"><%= s.title %></h3>
      </div>
      <p class="muted" style="margin:6px 0 4px"><%= s.now %></p>
      <p class="dim"><%= s.why %></p>
      <a class="btn" href="<%= s.href %>">Открыть</a>
    </div>
  <% }) %>
</div>

<% if (ready) { %>
  <div class="note ok">Всё настроено — можно собирать корзину и считать.</div>
<% } %>

<style>
.sugg-wrap{position:relative;}
.sugg{position:absolute;left:0;right:0;top:100%;z-index:30;margin:4px 0 0;padding:4px;list-style:none;max-height:52vh;overflow-y:auto;background:var(--bg1,#fff);border:1px solid var(--line2,#ddd);border-radius:12px;box-shadow:0 12px 28px rgba(0,0,0,.14);}
.sugg li{padding:12px;min-height:44px;display:flex;align-items:center;border-radius:8px;cursor:pointer;}
.sugg li[aria-selected="true"], .sugg li:hover{background:var(--line1,#f2f2f2);}
</style>
<script>
(function () {
  var field = document.getElementById("addr-input");
  var list = document.getElementById("addr-list");
  if (!field || !list) return;
  var timer = null;
  function hide() { list.hidden = true; list.innerHTML = ""; }
  function show(items) {
    list.innerHTML = "";
    if (!items.length) { hide(); return; }
    items.forEach(function (text) {
      var row = document.createElement("li");
      row.textContent = text;
      row.addEventListener("mousedown", function (e) { e.preventDefault(); field.value = text; hide(); });
      list.appendChild(row);
    });
    list.hidden = false;
  }
  field.addEventListener("input", function () {
    clearTimeout(timer);
    var t = field.value.trim();
    if (t.length < 3) { hide(); return; }
    timer = setTimeout(function () {
      fetch("/address/suggest?q=" + encodeURIComponent(t))
        .then(function (r) { return r.json(); })
        .then(function (d) { show((d && d.items) || []); })
        .catch(function () { hide(); });
    }, 250);
  });
  field.addEventListener("blur", function () { setTimeout(hide, 150); });
})();
</script>

<%- include('_foot') %>
