<%- include('_head', { title: 'Связи — Моя корзина' }) %>
<div class="card">
  <% rows.forEach((r) => { %>
    <div style="padding:10px 0;border-top:1px solid var(--line)">
      <strong><%= r.product %></strong>
      <div class="dim" style="margin-top:4px;font-size:0.86rem">
        <% r.matches.forEach((m, idx) => { %>
          <span class="dot s-<%= m.code %>"></span><%= m.name %> (<%= m.sku %>)<%= idx < r.matches.length - 1 ? ' · ' : '' %>
        <% }) %>
      </div>
    </div>
  <% }) %>
</div>
<%- include('_foot') %>
