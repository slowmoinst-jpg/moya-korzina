<%- include('_head', { title: 'Сравнение — Моя корзина' }) %>
<div class="card" style="overflow-x:auto">
  <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
    <thead>
      <tr style="border-bottom:1px solid var(--line2);text-align:left">
        <th style="padding:8px 6px">Товар</th>
        <% stores.forEach((s) => { %><th style="padding:8px 6px"><span class="dot s-<%= s.code %>"></span><%= s.name %></th><% }) %>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach((r) => { %>
        <tr style="border-top:1px solid var(--line)">
          <td style="padding:8px 6px"><%= r.name %></td>
          <% stores.forEach((s) => {
            const cell = r.byCode[s.code];
            const isBest = cell && cell.in_stock && r.minP !== null && Math.abs(cell.price - r.minP) < 0.01;
          %>
            <td style="padding:8px 6px;white-space:nowrap;<%= isBest ? 'color:var(--green);font-weight:700;' : '' %><%= cell && !cell.in_stock ? 'text-decoration:line-through;color:var(--ink3);' : '' %>">
              <%= cell ? rub(cell.price) : '—' %>
            </td>
          <% }) %>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('_foot') %>
