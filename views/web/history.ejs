<%- include('_head', { title: 'История — Моя корзина' }) %>
<div class="card">
  <div class="row">
    <strong>Позиций в истории: <%= rows.length %></strong>
    <span class="spacer"></span>
    <span class="sum">На сумму <%= rub(total) %></span>
  </div>
</div>
<% if (rows.length) { %>
  <div class="card">
    <% rows.forEach((r) => { %>
      <div class="row" style="justify-content:space-between;padding:7px 0;border-top:1px solid var(--line)">
        <span><span class="dot s-<%= r.store_code %>"></span><%= r.raw_name %> <span class="dim">· <%= r.store_name %> · <%= r.date %> · ×<%= num(r.qty) %></span></span>
        <span class="sum"><%= rub(r.total) %></span>
      </div>
    <% }) %>
  </div>
<% } %>
<%- include('_foot') %>
