<%- include('_head', { title: 'Корзина — Моя корзина' }) %>

<% if (missing) { %>
  <div class="note warn">Корзины №<%= missing %> нет — возможно, её удалили.
    <% if (baskets.length) { %>Ниже открыта последняя.<% } %></div>
<% } %>

<% if (!basket) { %>
  <div class="card">
    <div class="eyebrow">Корзина пуста</div>
    <h2>Собрать не из чего — пока</h2>
    <% if (usual.count) { %>
      <p class="muted">У вас есть покупки: в последней, от <%= usual.date %>, было
        <%= pluralItems(usual.count) %>.</p>
      <form method="post" action="/basket">
        <div class="grid two">
          <button class="btn main wide cart-go" type="submit" name="do" value="new:history">Как в прошлый раз</button>
          <button class="btn wide cart-go" type="submit" name="do" value="new:average">По среднему за месяц</button>
        </div>
        <div class="cart-find" style="margin-top:12px">
          <input class="cart-q" name="name" placeholder="Или своя: Неделя 38">
          <button class="btn" type="submit" name="do" value="new">Создать</button>
        </div>
      </form>
    <% } else { %>
      <p class="muted">Корзина собирается сама по вашим чекам — а чеков пока нет. Загрузите хотя бы один на экране «Мои чеки» или заведите пустую корзину.</p>
      <a class="btn main wide cart-go" href="/receipts">К моим чекам</a>
      <form method="post" action="/basket" class="cart-find" style="margin-top:14px">
        <input class="cart-q" name="name" placeholder="Или заведите пустую: Неделя 38">
        <button class="btn" type="submit" name="do" value="new">Создать</button>
      </form>
    <% } %>
  </div>
<% } else { %>

<div class="cart-head">
  <span class="cart-head-name"><%= basket.name %></span>
  <span class="dim">#<%= basket.id %></span>
</div>

<details class="cart-more">
  <summary>Другая корзина · создана <%= basket.created_at %></summary>
  <% if (baskets.length > 1) { %>
    <form method="get" action="/basket" class="cart-find" style="margin-top:10px">
      <select name="id">
        <% baskets.forEach((b) => { %>
          <option value="<%= b.id %>" <%= b.id === basket.id ? 'selected' : '' %>><%= b.name %></option>
        <% }) %>
      </select>
      <button class="btn" type="submit">Открыть</button>
    </form>
  <% } %>
  <form method="post" action="/basket" class="cart-find" style="margin-top:10px">
    <input name="name" placeholder="Новая корзина — например, Неделя 38">
    <button class="btn" type="submit" name="do" value="new">Создать</button>
  </form>
</details>

<% if (!address) { %>
  <div class="note warn">Адрес не указан — магазины ответят ценами не вашей точки. Укажите его в шапке.</div>
<% } %>

<div class="card cart-add">
  <form method="get" action="/basket" class="cart-find">
    <input type="hidden" name="id" value="<%= basket.id %>">
    <input class="cart-q" id="cart-q" name="q" value="<%= query %>" autocomplete="off"
           data-served="<%= query %>" aria-label="Найти товар"
           placeholder="молоко · хлеб · огурцы">
    <button class="btn" type="submit">Найти</button>
  </form>

  <div class="cart-hints" id="cart-hints"></div>

  <div id="cart-found">
    <% if (due.length && regulars.length) { %>
      <div class="row" style="margin-bottom:8px">
        <a class="btn <%= habit !== 'due' ? 'main' : '' %>" href="/basket?id=<%= basket.id %>&f=often">Покупаю постоянно</a>
        <a class="btn <%= habit === 'due' ? 'main' : '' %>" href="/basket?id=<%= basket.id %>&f=due">Пора докупить · <%= due.length %></a>
      </div>
    <% } %>
    <% if (due.length && (habit === 'due' || !regulars.length)) { %>
      <div class="cart-often-title">Пора докупить</div>
      <div class="cart-often">
        <% due.forEach((r) => { %>
          <button type="submit" form="cart-items" name="do" value="add:<%= r.product_id %>"
                  title="Берёте раз в <%= Math.round(r.cycle) %> дн., последний раз <%= r.since %> дн. назад">
            <span class="cart-often-plus">＋</span>
            <span class="cart-often-name"><%= r.name.slice(0, 26) %></span>
          </button>
        <% }) %>
      </div>
    <% } else if (regulars.length) { %>
      <div class="cart-often-title">Часто берёте</div>
      <div class="cart-often">
        <% regulars.forEach((r) => { %>
          <button type="submit" form="cart-items" name="do" value="add:<%= r.product_id %>"
                  title="Встречался в <%= r.times %> покупках">
            <span class="cart-often-plus">＋</span>
            <span class="cart-often-name"><%= r.name.slice(0, 26) %></span>
          </button>
        <% }) %>
      </div>
    <% } %>

    <% if (suggestions.length) { %>
      <div class="cart-often-title">Найденные товары<% if (query) { %> · «<%= query %>»<% } %></div>
      <% suggestions.forEach((p) => { %>
        <button class="cart-row" type="submit" form="cart-items" name="do" value="add:<%= p.id %>" style="margin-bottom:6px">
          <span class="cart-hit-text">
            <span class="cart-hit-name"><%= p.name %></span>
            <span class="cart-hit-small"><%= p.unit %><% if (p.brand) { %> · <%= p.brand %><% } %> · в <%= p.ready %> из <%= stores_n %> сетей</span>
          </span>
          <span class="cart-hit-plus">＋</span>
        </button>
      <% }) %>
    <% } else if (query) { %>
      <p class="dim" style="margin-top:12px">По запросу «<%= query %>» ничего не нашлось.</p>
    <% } %>
  </div>
</div>

<form method="post" action="/basket" id="cart-items">
  <input type="hidden" name="basket" value="<%= basket.id %>">
  <input type="hidden" name="q" id="cart-q-sent" value="<%= query %>">

  <% if (!items.length) { %>
    <div class="card">
      <div class="eyebrow">Корзина пуста</div>
      <h2>Пока ничего не набрано</h2>
      <p class="muted">Добавьте товары поиском выше или соберите корзину из прошлых покупок.</p>
      <% if (usual.count) { %>
        <div class="grid two">
          <button class="btn main wide cart-go" type="submit" name="do" value="fill:history">Собрать заново</button>
          <button class="btn wide cart-go" type="submit" name="do" value="fill:average">По среднему за месяц</button>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div class="cart-count">
      <h2>В корзине</h2>
      <span class="dim"><%= pluralItems(items.length) %></span>
    </div>

    <% items.forEach((it) => { %>
      <div class="cart-line">
        <div class="cart-line-top">
          <div class="cart-line-name"><%= it.name %></div>
          <div class="cart-line-sum sum"><%= it.best ? rub(it.best.value) : '—' %></div>
        </div>
        <div class="cart-line-where dim">
          <% if (it.best) { %>
            <span class="chip"><span class="dot s-<%= it.best.code %>"></span><%= it.best.store %></span>
            <% if (it.best.diff >= 0.5) { %>
              <span class="gain">дешевле на <%= rub(it.best.diff) %></span>
            <% } else { %>
              цена одна на <%= it.best.count %> сети
            <% } %>
          <% } else { %>
            цен нет
          <% } %>
        </div>

        <div class="cart-step">
          <button class="cart-pm" type="submit" name="do" value="minus:<%= it.pid %>" aria-label="Убавить <%= it.name %>">−</button>
          <input class="cart-qty" name="qty:<%= it.pid %>" value="<%= num(it.qty) %>" inputmode="decimal" aria-label="Сколько: <%= it.name %>">
          <span class="cart-unit dim"><%= unitLabel(it.unit) %></span>
          <button class="cart-pm" type="submit" name="do" value="plus:<%= it.pid %>" aria-label="Добавить <%= it.name %>">＋</button>
          <button class="cart-off" type="submit" name="do" value="drop:<%= it.pid %>" aria-label="Убрать <%= it.name %> из корзины">Убрать</button>
        </div>

        <% if (it.prices.length) { %>
          <details class="cart-prices">
            <summary class="dim">Цены по сетям</summary>
            <div class="row" style="gap:14px;margin-top:8px">
              <% it.prices.forEach((p) => { %>
                <span class="chip" style="<%= !p.in_stock ? 'color:var(--ink3);text-decoration:line-through' : (p.best ? 'color:var(--green);font-weight:600' : 'color:var(--ink3)') %>"
                      title="<%= p.name %>">
                  <span class="dot s-<%= p.code %>"></span><%= rub(p.value) %>
                </span>
              <% }) %>
            </div>
          </details>
        <% } %>
      </div>
    <% }) %>

    <div class="row" style="margin:12px 0 14px;gap:8px">
      <button class="btn cart-go" type="submit" name="do" value="save">Сохранить</button>
      <span class="spacer"></span>
      <button class="btn cart-off" type="submit" name="do" value="clear" style="margin-left:0">Очистить</button>
    </div>
  <% } %>
</form>

<% if (totals.length) { %>
  <div class="card" style="background:var(--tint)">
    <div class="row">
      <strong>Вся корзина в одном магазине</strong>
      <span class="spacer"></span>
      <% totals.forEach((t) => { %>
        <span class="chip" style="margin-left:10px" title="<%= t.name %>">
          <span class="dot s-<%= t.code %>"></span><span class="sum"><%= rub(t.value) %></span>
        </span>
      <% }) %>
    </div>
  </div>
<% } %>

<div class="cart-bar">
  <div class="cart-bar-num">
    <div class="cart-bar-sum sum"><%= approx.priced ? `≈ ${rub(approx.total)}` : '—' %></div>
    <div class="cart-bar-small">
      <% if (approx.count) { %>
        <%= pluralItems(approx.count) %><% if (approx.blind) { %> · <%= approx.blind %> без цены<% } %>
      <% } else { %>
        Пусто — добавьте первое сверху
      <% } %>
    </div>
  </div>
  <button class="btn main cart-go" type="submit" form="cart-items" name="do" value="calc" <%= !items.length ? 'disabled' : '' %>>Посчитать</button>
</div>

<script>
(function () {
  var field = document.getElementById('cart-q');
  var box = document.getElementById('cart-hints');
  var found = document.getElementById('cart-found');
  var sent = document.getElementById('cart-q-sent');
  if (!field || !box || !window.fetch) return;
  var basket = <%= JSON.stringify(basket.id) %>;
  var served = field.getAttribute('data-served') || '';
  var timer = null;
  function clear() { while (box.firstChild) box.removeChild(box.firstChild); }
  function draw(items) {
    clear();
    items.forEach(function (it) {
      var btn = document.createElement('button');
      btn.className = 'cart-hit';
      btn.type = 'submit';
      btn.name = 'do';
      btn.value = String(it.do || '');
      btn.setAttribute('form', 'cart-items');
      var t = document.createElement('span');
      t.className = 'cart-hit-text';
      var n = document.createElement('span');
      n.className = 'cart-hit-name';
      n.textContent = it.name || '';
      t.appendChild(n);
      if (it.small) {
        var s = document.createElement('span');
        s.className = 'cart-hit-small';
        s.textContent = it.small;
        t.appendChild(s);
      }
      btn.appendChild(t);
      var p = document.createElement('span');
      p.className = 'cart-hit-plus';
      p.textContent = '＋';
      btn.appendChild(p);
      box.appendChild(btn);
    });
  }
  function ask() {
    var q = field.value.trim();
    if (sent) sent.value = q;
    if (found) found.style.display = (q === served) ? '' : 'none';
    if (q.length < 2) { clear(); return; }
    fetch('/basket/suggest?q=' + encodeURIComponent(q) + '&id=' + encodeURIComponent(basket))
      .then(function (r) { return r.json(); })
      .then(function (d) { if (d && d.q === field.value.trim()) draw(d.items || []); })
      .catch(function () {});
  }
  field.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(ask, 200); });
})();
</script>
<% } %>

<%- include('_foot') %>
