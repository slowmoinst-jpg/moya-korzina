<%- include('_head', { title: 'Мои чеки — Моя корзина' }) %>
<% if (note) { %><div class="note ok"><%= note %></div><% } %>
<% if (err) { %><div class="note bad"><%= err %></div><% } %>

<div class="card">
  <div class="row">
    <div>
      <strong>Кабинет ФНС</strong>
      <div class="dim"><%= fnsConnected ? `Подключён${fnsPhone ? ' · ' + fnsPhone : ''}` : 'Не подключён' %></div>
    </div>
    <span class="spacer"></span>
    <% if (!isDemo) { %>
      <form method="post" action="/receipts">
        <button class="btn main" type="submit" name="do" value="sync">Проверить новые чеки</button>
      </form>
    <% } %>
  </div>
</div>

<% if (!isDemo) { %>
  <div class="card">
    <h3>Добавить чек текстом</h3>
    <p class="dim">Каждая строка: Название; количество; цена (например: Молоко Домик в деревне 3.2%; 2; 94.90)</p>
    <form method="post" action="/receipts">
      <div class="row" style="margin-bottom:8px">
        <select name="store">
          <% stores.forEach((s) => { %>
            <option value="<%= s.code %>"><%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <textarea name="text" rows="4" placeholder="Молоко 3.2%; 2; 94.90&#10;Батон нарезной; 1; 49.00"></textarea>
      <div class="row" style="margin-top:10px">
        <button class="btn main" type="submit" name="do" value="paste">Загрузить строки</button>
      </div>
    </form>
  </div>
<% } %>

<div class="card">
  <h3>Загруженные чеки (<%= receipts.length %>)</h3>
  <% if (!receipts.length) { %>
    <p class="dim">Чеков пока нет.</p>
  <% } else { %>
    <% receipts.forEach((r) => { %>
      <div class="row" style="justify-content:space-between;padding:7px 0;border-top:1px solid var(--line)">
        <span><b><%= r.store %></b> <span class="dim">· <%= r.date %> · <%= r.rows %> поз.</span></span>
        <span class="sum"><%= rub(r.total) %></span>
      </div>
    <% }) %>
  <% } %>
</div>
<%- include('_foot') %>
